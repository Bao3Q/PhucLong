generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum ProductSize {
  S
  M
  L
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum DiscountType {
  PERCENT
  FIXED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  role          UserRole @default(CUSTOMER)
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())

  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  payments            Payment[]
}

model Product {
  id          String  @id @default(cuid())
  name        String
  category    String  @default("Khác")
  price       Int
  imageUrl    String
  description String?
  tag         String?
  stock       Int     @default(0)
  version     Int     @default(0)

  orderItems  OrderItem[]
  recipeItems RecipeItem[]

  @@index([name])
}

model Promotion {
  id                Int          @id @default(autoincrement())
  code              String       @unique
  name              String
  description       String?
  discountType      DiscountType
  discountValue     Int
  maxDiscountAmount Int?
  minOrderAmount    Int          @default(0)
  usageLimit        Int?
  usedCount         Int          @default(0)
  isActive          Boolean      @default(true)
  startsAt          DateTime     @default(now())
  endsAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt

  orders Order[]

  @@index([isActive, startsAt, endsAt], map: "Promotion_active_dates_idx")
}

model Order {
  id             Int         @id @default(autoincrement())
  userId         String
  status         OrderStatus @default(PENDING)
  subtotal       Int         @default(0)
  discountAmount Int         @default(0)
  voucherCode    String?
  voucherDiscountAmount Int @default(0)
  loyaltyDiscountAmount Int @default(0)
  loyaltyPointsRedeemed Int @default(0)
  total          Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  promotion Promotion? @relation(fields: [voucherCode], references: [code], onDelete: SetNull, onUpdate: Cascade)

  items               OrderItem[]
  payments            Payment[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([voucherCode])
}

model OrderItem {
  id          Int         @id @default(autoincrement())
  orderId     Int
  productId   String
  productName String
  size        ProductSize
  toppings    String[]    @default([])
  note        String?
  qty         Int
  unitPrice   Int
  lineTotal   Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                 Int      @id @default(autoincrement())
  userId             String
  orderId            Int
  method             String
  idempotencyKey     String?
  result             Json
  createdAt          DateTime @default(now())
  amount             Int

  // Luồng SePay (chuyển khoản QR): phiên thanh toán có thời hạn
  status      String    @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUND_PENDING | REFUNDED
  expiresAt   DateTime?
  paidAt      DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Idempotency chặt: mỗi user chỉ được dùng một key cho một kết quả thanh toán
  // (chặn race khi hai request cùng key chạm đồng thời).
  @@unique([userId, idempotencyKey])
}

model LoyaltyTransaction {
  id           Int                    @id @default(autoincrement())
  userId       String
  orderId      Int?
  type         LoyaltyTransactionType
  points       Int
  balanceAfter Int
  description  String?
  createdAt    DateTime               @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([orderId])
}

model Ingredient {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  quantity  Decimal  @default(0) @db.Decimal(10, 2)
  unit      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  recipeItems RecipeItem[]
}

// Tồn kho ly theo size, trừ mỗi lần thanh toán thành công
model Cup {
  id        Int         @id @default(autoincrement())
  size      ProductSize @unique
  quantity  Int         @default(0)
  updatedAt DateTime    @default(now()) @updatedAt
}

// Công thức: lượng nguyên liệu dùng cho 1 ly của một món theo size
model RecipeItem {
  id           Int         @id @default(autoincrement())
  productId    String
  size         ProductSize
  ingredientId Int
  amount       Decimal     @db.Decimal(10, 2)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, size, ingredientId])
  // Khớp index RecipeItem_productId_size_idx mà migration add_recipes_cups đã tạo
  // (deductInventory tra cứu theo cặp productId + size nên cần index này).
  @@index([productId, size])
}
