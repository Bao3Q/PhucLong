# Copy file này thành .env và điền giá trị thật
# PostgreSQL local (PostgreSQL 18, database: maycha_db)
DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/maycha_db?schema=public"

# JWT (dùng cho module auth khi triển khai)
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"

# Port API
PORT=3001
