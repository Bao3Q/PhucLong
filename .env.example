# Environment Configuration for BrewLite / PhucLong Monorepo

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/phuclong_db?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=phuclong_db
POSTGRES_PORT=5433

# Backend API (NestJS)
PORT=4000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-for-brewlite-project-2026
JWT_EXPIRATION=1d
CORS_ORIGIN=http://localhost:3000

# Frontend Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000

# SePay — thanh toán online chuyển khoản QR
# Điền giá trị thật vào file .env (không commit secret lên repo!).
# Tạo tại https://my.sepay.vn: link tài khoản ngân hàng nhận tiền, rồi tạo
# webhook trỏ tới <API_URL>/payments/sepay/webhook với khóa API bên dưới.
# SEPAY_ACC=<số tài khoản nhận tiền>
# SEPAY_BANK=<mã ngân hàng, vd MB, Vietcombank>
# SEPAY_API_KEY=<khóa API của webhook SePay>
# SEPAY_QR_BASE=https://vietqr.app/img
# SEPAY_TIMEOUT_SECONDS=120


# Tự hủy đơn PENDING quá hạn (phút) — hoàn lại tồn kho. 0 = tắt
ORDER_PENDING_TTL_MINUTES=10
