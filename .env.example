# Environment Configuration for BrewLite / PhucLong Monorepo

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/phuclong_db?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=phuclong_db
POSTGRES_PORT=5433

# Backend API (NestJS)
PORT=4000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-for-brewlite-project-2026
JWT_EXPIRATION=1d
CORS_ORIGIN=http://localhost:3000

# Frontend Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
