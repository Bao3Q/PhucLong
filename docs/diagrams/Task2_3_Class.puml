@startuml Task2_3_Class
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 140
skinparam TitleFontSize 16
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor white
skinparam ClassBorderColor black
skinparam ClassFontColor black
skinparam ClassAttributeFontColor black
skinparam ClassStereotypeFontColor black
skinparam ArrowColor black
skinparam ArrowFontColor black
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam nodesep 60
skinparam ranksep 70
hide circle
title Class-01: SƠ ĐỒ LỚP MỨC DOMAIN — BREWLITE (PHÚC LONG)

class User {
  - id : UUID
  - email : String
  - passwordHash : String
  - role : UserRole
  - loyaltyPoints : int
  - createdAt : DateTime
  --
  + register()
  + login() : JWT
  + getOrderHistory() : Order[]
}
class Product {
  - id : String
  - name : String
  - category : String
  - price : int
  - imageUrl : String
  - description : String
  - stock : int
  - version : int
  --
  + reserveStock(qty : int)
  + restoreStock(qty : int)
}
class Order {
  - id : int
  - status : OrderStatus
  - subtotal : int
  - discountAmount : int
  - voucherCode : String
  - total : int
  - createdAt : DateTime
  --
  + calculateTotal() : int
  + changeStatus(next : OrderStatus)
  + cancel()
}
class OrderItem {
  - id : int
  - productName : String
  - size : ProductSize
  - toppings : String[]
  - note : String
  - qty : int
  - unitPrice : int
  - lineTotal : int
}
class Payment {
  - id : int
  - method : PaymentMethod
  - amount : int
  - status : PaymentStatus
  - idempotencyKey : String
  - transactionId : String
  - paymentCode : String
  - expiresAt : DateTime
  - paidAt : DateTime
  --
  + pay()
  + confirm()
}
class Promotion {
  - id : int
  - code : String
  - name : String
  - discountType : DiscountType
  - discountValue : int
  - maxDiscountAmount : int
  - minOrderAmount : int
  - usageLimit : int
  - usedCount : int
  - isActive : boolean
  - startsAt : DateTime
  - endsAt : DateTime
  --
  + validate(subtotal : int) : boolean
  + calculateDiscount(subtotal : int) : int
}
class LoyaltyTransaction {
  - id : int
  - type : LoyaltyTransactionType
  - points : int
  - balanceAfter : int
  - description : String
  - createdAt : DateTime
}

enum OrderStatus <<enumeration>> {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum PaymentStatus <<enumeration>> {
  PENDING
  PAID
  EXPIRED
  FAILED
}
enum PaymentMethod <<enumeration>> {
  MOMO
  CARD
  SEPAY
}
enum UserRole <<enumeration>> {
  CUSTOMER
  ADMIN
}
enum ProductSize <<enumeration>> {
  S
  M
  L
}
enum DiscountType <<enumeration>> {
  PERCENT
  FIXED
}
enum LoyaltyTransactionType <<enumeration>> {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

User "1" -- "0..*" Order : places >
Order "1" *-- "1..*" OrderItem : contains >
OrderItem "0..*" --> "1" Product : refers to >
Order "1" -- "0..*" Payment : paid by >
User "1" -- "0..*" Payment : makes >
Order "0..*" --> "0..1" Promotion : applies >
User "1" *-- "0..*" LoyaltyTransaction : owns >
Order "0..1" -- "0..*" LoyaltyTransaction : earns >

User ..> UserRole
Order ..> OrderStatus
OrderItem ..> ProductSize
Payment ..> PaymentStatus
Payment ..> PaymentMethod
Promotion ..> DiscountType
LoyaltyTransaction ..> LoyaltyTransactionType

note bottom of Payment
  UNIQUE (userId, idempotencyKey):
  gửi lại cùng key không tạo thanh toán mới.
  method/status lưu dạng text trong DB.
end note
note right of Product
  version: khoá lạc quan (optimistic lock)
  khi trừ tồn kho lúc tạo đơn
end note
@enduml
