@startuml Task2_3_Class
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 130
skinparam TitleFontSize 16
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor white
skinparam ClassBorderColor black
skinparam ClassFontColor black
skinparam ClassAttributeFontColor black
skinparam ClassStereotypeFontColor black
skinparam ArrowColor black
skinparam ArrowFontColor black
skinparam PackageBorderColor black
skinparam nodesep 50
skinparam ranksep 60
hide circle
hide empty members
title Class-01: SƠ ĐỒ LỚP MỨC DOMAIN — BREWLITE (PHÚC LONG)

class User {
  - id : String
  - email : String
  - passwordHash : String
  - role : UserRole
  - loyaltyPoints : int
  --
  + register()
  + login() : JWT
}
class Order {
  - id : int
  - status : OrderStatus
  - subtotal : int
  - discountAmount : int
  - voucherCode : String
  - total : int
  - createdAt : DateTime
  --
  + createOrder()
  + updateStatus(next)
}
class OrderItem {
  - productName : String
  - size : ProductSize
  - toppings : String[]
  - note : String
  - qty : int
  - unitPrice : int
  - lineTotal : int
}
class Product {
  - id : String
  - name : String
  - category : String
  - price : int
  - stock : int
  - version : int
}
class Payment {
  - id : int
  - method : PaymentMethod
  - status : PaymentStatus
  - success : boolean
  - amount : int
  - idempotencyKey : String
  - result : Json
  - expiresAt : DateTime
  - paidAt : DateTime
  --
  + processPayment()
}
class Promotion {
  - code : String
  - discountType : DiscountType
  - discountValue : int
  - maxDiscountAmount : int
  - minOrderAmount : int
  - usageLimit : int
  - usedCount : int
  - isActive : boolean
  - startsAt : DateTime
  - endsAt : DateTime
  --
  + validatePromotion()
}
class LoyaltyTransaction {
  - type : LoyaltyTransactionType
  - points : int
  - balanceAfter : int
  - createdAt : DateTime
}
class RecipeItem {
  - size : ProductSize
  {field} - amount : Decimal
}
class Ingredient {
  - name : String
  {field} - quantity : Decimal
  - unit : String
}
class Cup {
  - size : ProductSize
  - quantity : int
}

package "Enum" <<Rectangle>> {
  enum OrderStatus {
    PENDING
    PAID
    PAYMENT_FAILED
    PREPARING
    READY
    COMPLETED
    CANCELLED
  }
  enum PaymentStatus {
    PENDING
    PAID
    EXPIRED
    FAILED
  }
  enum PaymentMethod {
    momo
    card
    sepay
  }
  enum UserRole {
    CUSTOMER
    ADMIN
  }
  enum ProductSize {
    S
    M
    L
  }
  enum DiscountType {
    PERCENT
    FIXED
  }
  enum LoyaltyTransactionType {
    EARN
    REDEEM
    ADJUST
    EXPIRE
  }
}

User "1" -- "0..*" Order : places >
User "1" -- "0..*" Payment : makes >
User "1" *-- "0..*" LoyaltyTransaction : owns >
Order "1" *-- "1..*" OrderItem : contains >
Order "1" -- "0..*" Payment : paid by >
Order "0..*" --> "0..1" Promotion : applies >
Order "0..1" -- "0..*" LoyaltyTransaction : earns >
OrderItem "0..*" --> "1" Product : refers to >
Product "1" *-- "0..*" RecipeItem : recipe >
RecipeItem "0..*" --> "1" Ingredient : uses >

Cup -[hidden]right- RecipeItem
@enduml
