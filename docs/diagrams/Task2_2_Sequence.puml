@startuml Task2_2_Sequence
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 140
skinparam TitleFontSize 16
skinparam ParticipantBackgroundColor white
skinparam ParticipantBorderColor black
skinparam ActorBackgroundColor white
skinparam ActorBorderColor black
skinparam SequenceLifeLineBorderColor black
skinparam SequenceLifeLineBackgroundColor white
skinparam SequenceGroupBorderColor black
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupHeaderFontStyle bold
skinparam ArrowColor black
skinparam SequenceDividerBackgroundColor white
skinparam SequenceDividerBorderColor black
skinparam SequenceGroupHeaderFontColor black
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam sequenceMessageAlign left
hide footbox
title SEQUENCE DIAGRAM FOR UC-01: ĐẶT VÀ THANH TOÁN ĐƠN HÀNG (Sequence-01)

actor "Customer" as C
participant "UI: Next.js UI" as UI
participant "API: NestJS API" as API
participant "DB: Database\n(PostgreSQL)" as DB
participant "PS: Payment Service\n(Ví / Thẻ mô phỏng)" as PS

== Đặt đơn (UC-01a) ==
activate C
C -> UI : datHang (cart, voucherCode, method)
activate UI
break chưa có JWT (A2)
  UI --> C : chuyển /login?next=/checkout (giữ giỏ hàng)
end
UI -> API : POST /orders (Bearer JWT, items, voucherCode)
activate API
API -> API : verifyJWT (token)
break JWT sai / hết hạn (E1)
  API --> UI : 401 Unauthorized
  UI --> C : chuyển trang đăng nhập
end
API -> API : validate (items)
API -> DB : getProducts (productIds)
activate DB
DB --> API : products (giá)
deactivate DB
break dữ liệu không hợp lệ / sản phẩm không tồn tại (E2, E3)
  API --> UI : 400 / 404 + message
  UI --> C : hiển thị lỗi, giữ giỏ hàng
end
API -> API : tinhTien (items)
group Transaction tạo đơn + cập nhật tồn kho
  API -> DB : BEGIN
  opt có voucherCode (A1)
    API -> DB : validatePromotion (code, subtotal)
    DB --> API : discount
  end
  loop mỗi sản phẩm
    API -> DB : reserveStock (PID, qty, version)
    DB --> API : updated (0 / 1)
  end
  break hết hàng / xung đột (E4) hoặc mã sai (E5)
    API -> DB : ROLLBACK
    API --> UI : 400 / 409 + message
    UI --> C : thông báo hết hàng / mã không hợp lệ
  end
  API -> DB : insertOrder (UID, items, total, "PENDING")
  API -> DB : COMMIT
  DB --> API : order
end
API --> UI : 201 order (PENDING)
deactivate API
UI -> UI : clearCart (), tạo Idempotency-Key

== Thanh toán (UC-01b) ==
UI -> API : POST /payments (Bearer JWT, Idempotency-Key, orderId, method)
activate API
API -> API : verifyJWT (token)
API -> DB : findOrder (orderId)
activate DB
DB --> API : order
deactivate DB
break không phải chủ đơn (E2) / đơn đã PAID (E3)
  API --> UI : 403 / 400 + message
  UI --> C : hiển thị lỗi
end
API -> DB : findPayment (UID, Idempotency-Key)
activate DB
DB --> API : payment | null
deactivate DB
break cùng key nhưng khác nội dung (E4)
  API --> UI : 400 Idempotency-Key đã dùng
  UI --> C : hiển thị lỗi
end
alt client gửi lại cùng Idempotency-Key, cùng nội dung (A1)
  API --> UI : 201 payment đã lưu (không trừ tiền / kho lần hai)
else key mới
  API -> PS : charge (orderId, amount, method)
  activate PS
  PS --> API : result (transactionId)
  deactivate PS
  group Transaction thanh toán
    API -> DB : BEGIN
    API -> DB : deductCups (size, qty), deductIngredients (recipe)
    DB --> API : result
    alt thanh toán thành công (đủ ly và nguyên liệu)
      API -> DB : updateOrder (orderId, "PAID")
      API -> DB : addLoyaltyPoints (UID, points)
      API -> DB : insertPayment (orderId, method, "PAID", key)
      API -> DB : COMMIT
      API --> UI : 201 Message (PAID, transactionId)
    else thanh toán thất bại (bị từ chối / thiếu ly, nguyên liệu E5 / lỗi E6)
      API -> DB : ROLLBACK
      API --> UI : 400 Error (lý do), đơn vẫn PENDING
    end
  end
end
deactivate API
alt PAID
  UI --> C : "Đặt hàng thành công", trang /orders/:id hiển thị "Đã thanh toán"
else thất bại
  UI --> C : thông báo thất bại, nút thử lại
end
deactivate UI
note over PS
  Dịch vụ mô phỏng luôn chấp nhận;
  thất bại thực tế đến từ thiếu ly /
  nguyên liệu hoặc lỗi DB (rollback).
  Luồng thay thế A2 (SePay):
  xem Task2_1_Activity_SePay.
end note
@enduml
