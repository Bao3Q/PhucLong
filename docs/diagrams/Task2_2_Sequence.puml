@startuml Task2_2_Sequence
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 130
skinparam TitleFontSize 16
skinparam ParticipantBackgroundColor white
skinparam ParticipantBorderColor black
skinparam ActorBackgroundColor white
skinparam ActorBorderColor black
skinparam SequenceLifeLineBorderColor black
skinparam SequenceLifeLineBackgroundColor white
skinparam SequenceGroupBorderColor black
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupHeaderFontStyle bold
skinparam ArrowColor black
skinparam SequenceDividerBackgroundColor white
skinparam SequenceDividerBorderColor black
skinparam SequenceGroupHeaderFontColor black
skinparam sequenceMessageAlign left
hide footbox
title SEQUENCE DIAGRAM FOR UC-01: ĐẶT VÀ THANH TOÁN ĐƠN HÀNG (Sequence-01)

actor "Customer" as C
participant "Next.js UI" as UI
participant "NestJS API" as API
participant "Database" as DB
participant "Payment Service\n(mô phỏng)" as PS

== Đặt đơn (UC-01a) ==
activate C
C -> UI : bấm "Xác nhận trả" (momo / card)
activate UI
break chưa đăng nhập (A2)
  UI --> C : chuyển /login (giữ giỏ hàng)
end
UI -> API : POST /orders (JWT, items, voucherCode)
activate API
API -> API : kiểm tra JWT, validate items
break JWT sai (E1) / dữ liệu sai (E2)
  API --> UI : 401 / 400
  UI --> C : báo lỗi
end
API -> DB : lấy giá sản phẩm
activate DB
DB --> API : products
deactivate DB
break sản phẩm không tồn tại (E3)
  API --> UI : 404
  UI --> C : báo lỗi
end
API -> API : tính tiền (server tự tính giá)
group Transaction tạo đơn + cập nhật tồn kho
  opt có mã giảm giá (A1)
    API -> DB : kiểm tra mã
  end
  loop mỗi sản phẩm
    API -> DB : trừ tồn kho (theo version)
    DB --> API : 0 / 1 dòng
  end
  break mã sai (E5) / hết hàng / xung đột (E4)
    API -> DB : ROLLBACK
    API --> UI : 400 / 409
    UI --> C : báo hết hàng / mã sai
  end
  API -> DB : tạo đơn PENDING, COMMIT
end
API --> UI : 201 order (PENDING)
deactivate API

== Thanh toán Ví / Thẻ (UC-01b) ==
UI -> UI : xoá giỏ, tạo Idempotency-Key
UI -> API : POST /payments (JWT, Idempotency-Key, orderId, method)
activate API
API -> API : kiểm tra JWT
API -> DB : lấy đơn
activate DB
DB --> API : order
deactivate DB
break JWT sai (E1) / không có đơn / không phải chủ đơn (E2)
  API --> UI : 401 / 404 / 403
  UI --> C : báo lỗi
end
API -> DB : tìm Payment theo (user, key)
activate DB
DB --> API : payment | null
deactivate DB
alt cùng key, cùng nội dung (A1)
  API --> UI : 201 kết quả cũ (không trừ lần hai)
else cùng key, khác nội dung (E4)
  API --> UI : 400
else key mới
  break đơn đã PAID (E3)
    API --> UI : 400
  end
  API -> PS : charge (method, total)
  activate PS
  PS --> API : transactionId
  deactivate PS
  group Transaction thanh toán
    API -> DB : trừ ly + nguyên liệu
    alt đủ ly và nguyên liệu
      API -> DB : đơn PAID, cộng điểm, ghi Payment, COMMIT
      API --> UI : 201 PAID (transactionId)
    else thiếu ly / nguyên liệu (E5) hoặc lỗi (E6)
      API -> DB : ROLLBACK
      API --> UI : 400 (đơn vẫn PENDING)
    end
  end
end
deactivate API
alt thành công
  UI --> C : trang "Đặt hàng thành công"
else thất bại
  UI --> C : báo lỗi, cho thanh toán lại
end
deactivate UI
@enduml
