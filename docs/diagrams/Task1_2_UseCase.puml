  usecase "UC04 Đăng ký\n(FR-04)" as UC04
  usecase "UC05 Đăng nhập (JWT)\n(FR-04)" as UC05
  usecase "UC06 Đặt đơn hàng\n(FR-05)" as UC06
  usecase "UC07 Thanh toán đơn\n(FR-06)" as UC07
  usecase "UC08 Áp mã khuyến mãi\n(FR-08)" as UC08
