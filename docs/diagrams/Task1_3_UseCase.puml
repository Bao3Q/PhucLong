@startuml Task1_3_UseCase
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 14
skinparam ArrowColor black
skinparam dpi 150
skinparam packageStyle rectangle
left to right direction

title Task 1.3 - Use-case UC-01: Đặt và thanh toán đơn hàng

actor "Khách hàng" as KH

rectangle "UC-01: Đặt và thanh toán đơn hàng" {
  usecase "Thêm món vào giỏ" as ADD
  usecase "Quản lý giỏ hàng" as CART
  usecase "Áp mã khuyến mãi" as PROMO
  usecase "Đặt đơn" as ORDER
  usecase "Đăng nhập" as LOGIN
  usecase "Thanh toán đơn" as PAYUC
  usecase "Thanh toán Ví / Thẻ" as WALLET
  usecase "Thanh toán QR SePay" as QR
  usecase "Gửi lại cùng\nIdempotency-Key" as RETRY
  usecase "Xem xác nhận đơn" as CONFIRM
}

actor "Dịch vụ thanh toán\nmô phỏng" as PAY
actor "Cổng SePay" as SEPAY

KH --> ADD
KH --> CART
KH --> ORDER
KH --> CONFIRM

ORDER ..> LOGIN : <<include>>
ORDER ..> PAYUC : <<include>>
PROMO ..> ORDER : <<extend>>
PAYUC <|-- WALLET
PAYUC <|-- QR
RETRY ..> WALLET : <<extend>>

WALLET --> PAY
QR --> SEPAY
@enduml
