@startuml
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 14
skinparam ArrowColor black
skinparam dpi 160
skinparam packageStyle rectangle
left to right direction

title Use-case UC-01: Đặt và thanh toán đơn hàng

actor "Khách hàng" as KH

rectangle "UC-01: Đặt và thanh toán đơn hàng" {
  usecase "Thêm món vào giỏ\n(size, topping)" as ADD
  usecase "Áp mã khuyến mãi\n/ điểm thưởng" as PROMO
  usecase "Đặt đơn" as ORDER
  usecase "Đăng nhập" as LOGIN
  usecase "Thanh toán\n(Ví/Thẻ hoặc QR SePay)" as PAYUC
  usecase "Xem xác nhận đơn" as CONFIRM
}

actor "Cổng thanh toán\n(Ví/Thẻ, SePay)" as PAY

KH -- ADD
KH -- ORDER
KH -- PAYUC
KH -- CONFIRM

PROMO .[norank].> ORDER : <<extend>>
ORDER .[norank].> LOGIN : <<include>>
PAYUC -- PAY
@enduml
