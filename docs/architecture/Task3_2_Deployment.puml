@startuml
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam ArrowColor black
skinparam dpi 130
skinparam nodesep 40
skinparam ranksep 60


title Task 3.2 - Deployment diagram BrewLite Phúc Long (production thực tế: Vercel + Render + Neon + GHCR)

' ===================== LOCAL =====================
frame "LOCAL (máy lập trình viên)" as LOCAL {
  node "Laptop dev\n<<device>>" as DEV {
    artifact "Mã nguồn monorepo\n(apps/web, apps/api)" as SRC
    node "Docker Engine\n<<execution environment>>" as DOCKER {
      artifact "docker-compose.yml\nweb :3000 · api :4000 · postgres :5433" as COMPOSE
    }
    file ".env (không commit)" as LENV
  }
}

' ===================== CI =====================
frame "CI/CD (GitHub)" as CI {
  node "GitHub\n<<SaaS>>" as GH {
    artifact "Repository Bao3Q/PhucLong\n(branch main, PR)" as REPO
    node "GitHub Actions runner\n<<ubuntu-latest>>" as RUNNER {
      artifact "ci.yml\nlint · unit test · integration test\n(PostgreSQL service) · E2E Playwright · build" as CIYML
      artifact "cd.yml\nbuild image → migrate → deploy\n→ smoke test → rollback" as CDYML
    }
    file "GitHub Secrets\nRENDER_DEPLOY_HOOK_URL\nRENDER_API_KEY · RENDER_SERVICE_ID\nPROD_DATABASE_URL" as GHSEC
  }
  node "GitHub Container Registry\n<<container registry>>\nghcr.io/bao3q/phuclong-api" as GHCR {
    artifact "image phuclong-api\ntag sha-xxxxxxx · 1.0.0 · stable" as IMG
  }
}

' ===================== PRODUCTION =====================
frame "PRODUCTION (Internet, HTTPS)" as PROD {
  node "Thiết bị người dùng\n<<device: điện thoại / PC>>" as USER {
    node "Trình duyệt / PWA\n<<execution environment>>" as BROWSER {
      artifact "BrewLite PWA\n(manifest, localStorage giỏ hàng, JWT)" as PWA
    }
  }

  node "Vercel Edge Network / CDN\n<<PaaS>>\nphuc-long-omega.vercel.app" as VERCEL {
    artifact "Next.js 16 Web\n(SSR + static assets)" as WEB
    file "Env: API_PROXY_TARGET\n(rewrite /api/* → API)" as VENV
    artifact "Build & runtime logs" as VLOG
  }

  node "Render Web Service\n<<PaaS, Docker container>>\nphuclong-kf14.onrender.com" as RENDER {
    node "Container Node.js 22\n<<execution environment>>\nPORT nội bộ (EXPOSE 4000)" as CONT {
      artifact "NestJS 11 API\n(dist/main.js)\nauth · products · orders\npayments · inventory" as API
      artifact "Payment Service mô phỏng\n(module payments, idempotency)" as PAYM
      artifact "GET /health\n(SELECT 1 → 200 / 503)" as HEALTH
      artifact "prisma migrate deploy\n(chạy khi khởi động)" as MIG
    }
    file "Env/Secrets Render:\nDATABASE_URL · JWT_SECRET\nCORS_ORIGIN · SEPAY_*" as RENV
    artifact "Logs (stdout NestJS)\n+ Health check của Render" as RLOG
  }

  node "Neon Serverless PostgreSQL\n<<DBaaS>>" as NEON {
    database "PostgreSQL 16\n(persistent storage,\nbackup / point-in-time restore)" as PG
  }

  node "SePay\n<<dịch vụ thanh toán bên ngoài>>" as SEPAY
}

' ===================== KẾT NỐI =====================
SRC --> REPO : git push / pull request\nHTTPS 443
COMPOSE ..> LENV : đọc cấu hình

REPO --> RUNNER : trigger PR / push main / tag v*
CDYML --> IMG : docker push\nHTTPS 443
CDYML ..> GHSEC : đọc secrets.*
CDYML --> RENDER : POST deploy hook\n(Render API, HTTPS 443)
CDYML --> HEALTH : smoke test\nGET /health, /products, CORS
CDYML --> PG : prisma migrate deploy\n(TLS 5432, PROD_DATABASE_URL)
IMG ..> CONT : image chạy trong container\n(khi RENDER_IMAGE_DEPLOY=true)
REPO ..> VERCEL : Git integration\n(build tự động khi merge main)

PWA --> WEB : HTTPS 443
WEB --> API : HTTPS 443 REST/JSON\n(CORS_ORIGIN = domain Vercel)
API --> PG : TCP 5432, TLS (sslmode=require)\nkhông public trực tiếp,\nchỉ API có connection string
SEPAY --> API : webhook HTTPS 443\nPOST /payments/sepay/webhook
API ..> RENV : đọc biến môi trường
@enduml
