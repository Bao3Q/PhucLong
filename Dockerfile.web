# ---------- BUILD STAGE ----------
FROM node:22-bookworm-slim AS build
WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci

COPY apps/web ./apps/web

# NEXT_PUBLIC_* và API_PROXY_TARGET đều được bake vào build output lúc build
# (Next.js đánh giá rewrites() khi `next build`, không phải khi `next start`).
# Mặc định trỏ sang service "backend" trong mạng compose; build local không
# cần đặt gì vì next.config.ts tự fallback về localhost:4000 khi unset.
ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ARG API_PROXY_TARGET="http://backend:4000"
ENV API_PROXY_TARGET=${API_PROXY_TARGET}
RUN cd apps/web && npm run build && cd /workspace && npm prune --omit=dev

# ---------- RUNTIME STAGE ----------
FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /workspace/apps/web

# npm workspaces hoist deps lên root node_modules — copy root là đủ.
COPY --from=build /workspace/node_modules /workspace/node_modules
COPY --from=build /workspace/apps/web/.next ./.next
COPY --from=build /workspace/apps/web/public ./public
COPY --from=build /workspace/apps/web/package.json ./package.json
COPY --from=build /workspace/apps/web/next.config.ts ./next.config.ts

# (API_PROXY_TARGET đã bake lúc build — không set lại ở runtime,
#  việc đặt env ở compose sẽ không thay đổi được rewrite đã bake.)

USER node
EXPOSE 3000
CMD ["npm", "start"]
